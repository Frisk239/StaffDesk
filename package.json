{
  "name": "staffdesk",
  "private": true,
  "scripts": {
    "prototype": "npm run dev --prefix prototype",
    "dev": "npm run dev --prefix app",
    "build": "npm run build --prefix app",
    "lint": "npm run lint --prefix app",
    "typecheck": "npm run typecheck --prefix app",
    "test": "npm run test --prefix app",
    "test:watch": "npm run test:watch --prefix app",
    "eval": "npm run eval --prefix app",
    "e2e": "npm run e2e --prefix app",
    "package": "npm run package --prefix app",
    "native:check": "npm run native:check --prefix app",
    "rebuild": "npm run rebuild --prefix app",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^19.8.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1"
  },
  "lint-staged": {
    "app/**/*.{ts,tsx,js,cjs,mjs,css,json,yml,md}": "npm run format --prefix app --",
    "app/**/*.{ts,tsx}": "npm run lint:fix --prefix app --"
  }
}
